# Banco de dados
# DATABASE_URL: usar a connection string do Pooler (Transaction/Session) do Supabase em runtime.
# Recomendado para ambientes serverless/containers (menos conexões, melhor p/ Cloudflare/Railway/etc).
DATABASE_URL=

# Conexão DIRETA (sem PgBouncer) — OBRIGATÓRIA para migrations, seeds e comandos CLI do Medusa.
# Motivo: alguns comandos DDL podem falhar pelo pooler. Issue referência: medusajs/medusa#15646
# Use a URL direta do Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=
# Alias opcional (alguns scripts/CI usam este nome). Pode apontar para a mesma URL direta.
MIGRATION_DATABASE_URL=

DB_NAME=medusa-backend

